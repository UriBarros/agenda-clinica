{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://agenda-clinica.genesisinnovation.io/schema/agenda-clinica-1.json",
 "title": "agenda-clinica/1: arquivo de intercâmbio de uma clínica (ou barbearia, ou outro negócio com hora marcada)",
 "type": "object",
 "required": ["formato", "clinica", "locais", "profissionais", "servicos", "bloqueios", "com_pacientes"],
 "additionalProperties": false,
 "properties": {
  "formato": {"const": "agenda-clinica/1"},
  "clinica": {"type": "object", "additionalProperties": false,
   "required": ["slug", "nome", "descricao", "telefone", "email", "cidade", "tz", "passo_min", "antecedencia_min", "nicho"],
   "properties": {"slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$"}, "nome": {"type": "string", "maxLength": 100}, "descricao": {"type": "string"},
    "telefone": {"type": "string"}, "email": {"type": "string"}, "cidade": {"type": "string"}, "tz": {"type": "string", "description": "fuso IANA, ex.: America/Sao_Paulo"},
    "passo_min": {"enum": [10, 15, 20, 30, 45, 60]}, "antecedencia_min": {"type": "integer", "minimum": 0, "maximum": 10080},
    "nicho": {"type": "string", "description": "chave de nichos.json; desconhecida = clinica"}}},
  "locais": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["ref", "nome", "endereco", "cidade", "ativo"],
   "properties": {"ref": {"type": "integer"}, "nome": {"type": "string"}, "endereco": {"type": "string"}, "cidade": {"type": "string"}, "ativo": {"enum": [0, 1]}}}},
  "profissionais": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["ref", "nome", "especialidade", "registro", "bio", "ativo", "janelas"],
   "properties": {"ref": {"type": "integer"}, "nome": {"type": "string"}, "especialidade": {"type": "string"}, "registro": {"type": "string"}, "bio": {"type": "string"}, "ativo": {"enum": [0, 1]},
    "janelas": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["dia", "inicio", "fim", "local"],
     "properties": {"dia": {"type": "integer", "minimum": 0, "maximum": 6, "description": "0 = domingo"}, "inicio": {"type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$"},
      "fim": {"type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$"}, "local": {"type": "integer", "description": "ref de um item de locais"}}}}}}},
  "servicos": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["ref", "nome", "duracao_min", "preco_centavos", "ativo"],
   "properties": {"ref": {"type": "integer"}, "nome": {"type": "string"}, "duracao_min": {"type": "integer", "minimum": 5}, "preco_centavos": {"type": ["integer", "null"], "minimum": 0}, "ativo": {"enum": [0, 1]}}}},
  "bloqueios": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["profissional", "inicio", "fim", "motivo"],
   "properties": {"profissional": {"type": ["integer", "null"], "description": "ref do profissional; nulo = o negócio todo"}, "inicio": {"type": "string"}, "fim": {"type": "string"}, "motivo": {"type": "string"}}}},
  "com_pacientes": {"type": "boolean", "description": "true = o arquivo traz agendamentos, com nome e telefone de pessoas (dado pessoal, LGPD)"},
  "agendamentos": {"type": "array", "items": {"type": "object", "additionalProperties": false,
   "required": ["profissional", "local", "servico", "paciente_nome", "paciente_tel", "paciente_email", "data", "inicio", "fim", "status", "cancelado_por", "codigo", "origem"],
   "properties": {"profissional": {"type": "integer"}, "local": {"type": "integer"}, "servico": {"type": "integer"}, "paciente_nome": {"type": "string"}, "paciente_tel": {"type": "string"},
    "paciente_email": {"type": "string"}, "data": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, "inicio": {"type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$"},
    "fim": {"type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$"}, "status": {"enum": ["confirmado", "cancelado"]}, "cancelado_por": {"type": ["string", "null"]},
    "codigo": {"type": "string", "description": "código da consulta (base64url): vale nos links /m/<código>"}, "origem": {"type": "string"}}}},
  "personalizar": {"type": "object", "additionalProperties": false,
   "properties": {"cor": {"type": "string", "pattern": "^#[0-9a-f]{6}$"}, "rotulos": {"type": "object", "additionalProperties": {"type": "string", "maxLength": 80}}}}
 }
}
